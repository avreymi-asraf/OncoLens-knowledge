{
  "permissions": {
    "allow": [
      "Bash(uv run scripts/kb.py *)",
      "Bash(uv sync*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Edit(cortex/**)",
      "Write(cortex/**)",
      "Write(studio/**)",
      "Edit(studio/**)"
    ],
    "deny": [
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(py *)",
      "Bash(pip *)",
      "Bash(pip3 *)",
      "Bash(uv pip *)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git push --no-verify*)",
      "Edit(sources/**)",
      "Edit(cortex/_index/**)",
      "Write(cortex/_index/**)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/session_start.sh\"",
            "timeout": 180
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"$CLAUDE_PROJECT_DIR\" \"$CLAUDE_PROJECT_DIR/scripts/kb.py\" hook-post-write"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "ingestor",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --quiet --project \"$CLAUDE_PROJECT_DIR\" \"$CLAUDE_PROJECT_DIR/scripts/kb.py\" hook-subagent-stop",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
